# Public RPC fallback. When ALCHEMY_API_KEY is set, Alchemy is tried first.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Alchemy Robinhood mainnet → https://robinhood-mainnet.g.alchemy.com/v2/{KEY}
ALCHEMY_API_KEY=
# Extra comma-separated RPC URLs (after Alchemy / RPC_URL), for failover.
RPC_URLS=

# Optional Blockscout Pro API key (api.blockscout.com)
BLOCKSCOUT_API_KEY=

# GMGN OpenAPI keys (https://gmgn.ai/ai) for wallet activity / follow-up scans.
# Empty → public docs key (shared rate limit). Prefer a pool for ≤15s cycles:
#   GMGN_API_KEYS=key1,key2,key3
# and/or numbered vars (merged + deduped with GMGN_API_KEY):
GMGN_API_KEY=
GMGN_API_KEY_2=
GMGN_API_KEY_3=
GMGN_API_KEYS=

# Default early-buyer market-cap threshold (USD)
MCAP_THRESHOLD=15000

# Block range per eth_getLogs request (lower = safer on public RPC)
LOG_CHUNK_SIZE=100000
RPC_CONCURRENCY=24

# Optional: funded EOА (≥0.05 ETH) for honeypot buy→sell eth_call simulation.
# If empty, auto-picked from WETH holders via Blockscout.
HONEYPOT_SIM_WHALE=

# Host / port for API
HOST=0.0.0.0
PORT=8000

# Telegram bot for watch alerts (create via @BotFather)
TELEGRAM_BOT_TOKEN=
# Default chat id (override per watch config in UI if needed)
TELEGRAM_CHAT_ID=
# Optional forum topic id (message_thread_id). Leave empty for General / no topics.
TELEGRAM_TOPIC_ID=

# Optional paths for watch config / dedup / last-run state / ATH hold queue
# (Docker bind-mounts ./backend/app/data — keep defaults unless you relocate state)
# WATCH_CONFIG_PATH=backend/app/data/watch.json
# WATCH_SEEN_PATH=backend/app/data/watch_seen.json
# WATCH_STATE_PATH=backend/app/data/watch_state.json
# WATCH_HOLD_PATH=backend/app/data/watch_hold.json

# Follow-up watchlist (SQLite) + optional RayBot EVM sync
# FOLLOWUP_DB_PATH=backend/app/data/followup.db
# FOLLOWUP_CONFIG_PATH=backend/app/data/followup.json
# Durable exact unique-token cache (TTL seconds; default 6h)
# UNIQUE_CACHE_PATH=backend/app/data/wallet_unique.db
# UNIQUE_CACHE_TTL_SEC=21600
# Get api_user + token via /api in RayBot Telegram bot
RAYBOT_API_USER=
RAYBOT_API_TOKEN=
# Bot number (1 = @ray_purple_bot). See docs.raybot.app
RAYBOT_BOT=1
RAYBOT_BASE_URL=https://webapi.raybot.app
# Optional Authorization header value for POST /api/followup/webhook/raybot
RAYBOT_WEBHOOK_AUTH=

# External Theseusure/truegnomode screener for watch/Хвать token feed.
# Empty = use local token_index screener (default).
# When set, each watch cycle POSTs /api/screen and polls /api/screen/{job_id}.
# Example (truegnomode on host port 8001 while gnomode docker uses 8000):
#   TRUEGNOMODE_SCREENER_URL=http://host.docker.internal:8001
#   TRUEGNOMODE_SCREEN_TIMEOUT_SEC=180
#   TRUEGNOMODE_POLL_INTERVAL_SEC=0.5
TRUEGNOMODE_SCREENER_URL=
TRUEGNOMODE_SCREEN_TIMEOUT_SEC=180
TRUEGNOMODE_POLL_INTERVAL_SEC=0.5
