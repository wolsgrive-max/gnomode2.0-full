# Public RPC by default. Upgrade to dRPC or QuickNode when rate-limited.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional Blockscout Pro API key (api.blockscout.com)
BLOCKSCOUT_API_KEY=

# Default early-buyer market-cap threshold (USD) — first buy must be ≤ this
MCAP_THRESHOLD=20000
# Sniper discovery: max first-buy mcap to start tracking
SNIPER_MAX_FIRST_MCAP=20000

# Block range per eth_getLogs request (lower = safer on public RPC)
LOG_CHUNK_SIZE=100000
RPC_CONCURRENCY=24
# Parallel tokens per manual /api/parse job (2–3 is usually enough)
PARSE_TOKEN_CONCURRENCY=2

# Optional: funded EOА (≥0.05 ETH) for honeypot buy→sell eth_call simulation.
# If empty, auto-picked from WETH holders via Blockscout.
HONEYPOT_SIM_WHALE=

# Host / port for API
HOST=0.0.0.0
PORT=8000

# Telegram bot for watch alerts (create via @BotFather)
TELEGRAM_BOT_TOKEN=
# Default chat id (override per watch config in UI if needed)
TELEGRAM_CHAT_ID=
# Optional forum topic id (message_thread_id). Leave empty for General / no topics.
TELEGRAM_TOPIC_ID=

# Optional paths for watch config / dedup / last-run state
# WATCH_CONFIG_PATH=backend/app/data/watch.json
# WATCH_SEEN_PATH=backend/app/data/watch_seen.json
# WATCH_STATE_PATH=backend/app/data/watch_state.json

# SQLite sniper/migration DB
# DB_PATH=backend/app/data/gnomode.db

# WebSocket RPC for migration bus (defaults to wss:// from RPC_URL)
# WSS_RPC_URL=
MIGRATION_BUS_ENABLED=true
SNIPER_LIMIT=10
MIN_BUY_USD=0
# RayBot follow-up (trade #2/#3 of tracked snipers)
SNIPER_FOLLOW_ENABLED=true
SNIPER_FOLLOW_INTERVAL_SEC=12
SNIPER_ALERT_MAX_TRADE=3
TELEGRAM_BOT_POLLING=true
SNIPER_DEFAULT_MAX_MCAP_USD=150000
SNIPER_DEFAULT_MIN_BUY_USD=50
